---
interface Props { id?: string; class?: string }
const { id, class: cls = '' } = Astro.props;
---
<!-- Inline so the parts can animate. Decorative: the brand name is always next to it as text. -->
<svg id={id} class={cls} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle class="logo-ripple fill-none stroke-brand" cx="32" cy="32" r="30" stroke-width="2" opacity="0" />
  <circle class="logo-disc fill-brand" cx="32" cy="32" r="30" />
  <path class="logo-tri fill-on-brand" d="M25 20v24l21-12z" />
</svg>
