---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="sharu: share your screen">
  <main id="main">
    <h1>sharu</h1>
    <p class="muted">Share your screen peer-to-peer, right in the browser. No account. Your audio and video are never processed.</p>
    <div class="grid">
      <section class="card" aria-labelledby="share-h">
        <h2 id="share-h">Share your screen</h2>
        <p>Create a session and send the link to up to four people.</p>
        <a id="share-action" class="btn btn-primary btn-xl" href={`${base}/host/`}>Start sharing</a>
        <p id="share-unsupported" class="notice" hidden>This device can only watch. Most phones and tablets cannot share their screen from a browser.</p>
      </section>
      <section class="card" aria-labelledby="join-h">
        <h2 id="join-h">Join a session</h2>
        <form id="join-form" novalidate>
          <label for="code">Session link or code</label>
          <input id="code" name="code" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="code-help code-error" placeholder="Caesar-23-Pyramid" />
          <p id="code-help" class="muted">Paste the link, or type the code.</p>
          <p id="code-error" class="error" role="alert"></p>
          <button class="btn btn-primary" type="submit">Join</button>
        </form>
      </section>
    </div>
    <noscript><p class="notice">sharu needs JavaScript for screen sharing.</p></noscript>
  </main>
  <script>import '../scripts/landing.ts';</script>
</Base>
